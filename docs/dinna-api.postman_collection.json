        {
          "name": "POST /products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) pm.collectionVariables.set('createdProductId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Milkshake\",\n  \"description\": \"Creme de baunilha\",\n  \"category\": \"bebidas\",\n  \"priceCents\": 1890\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/products",
            "description": "201 com `id` gerado (`p_…`). `available` vira `true` e `imageUrl` vira `null` se omitidos. O script grava o id em `createdProductId`."
