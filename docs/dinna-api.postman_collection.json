              "raw": "{\n  \"name\": \"Burger Clássico+\",\n  \"description\": \"Pão brioche, blend 180g, queijo cheddar e salada\",\n  \"category\": \"burgers\",\n  \"priceCents\": 3490,\n  \"imageUrl\": null,\n  \"available\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Substitui o produto. 200 com o Product atualizado. Body igual ao de criação (sem id)."
          },
          "response": []
        },
        {
          "name": "DELETE /products/:id (soft-delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/{{createdProductId}}",
            "description": "204 sem corpo. Marca `available: false` e não apaga o registro. Rode o POST antes: este request usa `createdProductId`. Repetir o DELETE no mesmo id continua 204. Id inexistente devolve 404 `PRODUCT_NOT_FOUND`."
          },
          "response": []
        }
      ]
